---
// Franja de asfalto con la línea discontinua avanzando, como si fueras conduciendo.
// Solo transform en un elemento: va en la GPU. Con movimiento reducido, quieta.
---

<div class="relative h-14 overflow-hidden bg-asfalto" aria-hidden="true">
  <div class="absolute inset-x-0 top-2 h-[3px] bg-white/25"></div>
  <div class="absolute inset-x-0 bottom-2 h-[3px] bg-white/25"></div>
  <div class="linea absolute top-1/2 left-0 h-1.5 w-[calc(100%+96px)] -translate-y-1/2"></div>
</div>

<style>
  .linea {
    background: repeating-linear-gradient(90deg, var(--color-amarillo) 0 56px, transparent 56px 96px);
    animation: avanza 1.1s linear infinite;
  }
  @keyframes avanza {
    to {
      transform: translateX(-96px);
    }
  }
</style>
