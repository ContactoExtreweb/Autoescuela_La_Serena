---
// «¿Cuándo se suspende el práctico?»: suma faltas y te dice si sería apto. Sin JS se ven las reglas y las listas.
import { FALTAS } from '../lib/permisos.js'

const TIPOS = [
  { id: 'e', nombre: 'Eliminatoria', lista: FALTAS.eliminatorias, color: 'bg-red-600 text-white' },
  { id: 'd', nombre: 'Deficiente', lista: FALTAS.deficientes, color: 'bg-amarillo text-asfalto' },
  { id: 'l', nombre: 'Leve', lista: FALTAS.leves, color: 'bg-senal text-white' },
]
---

<div class="grid gap-8 lg:grid-cols-[1fr_1.1fr]" data-faltas>
  <div>
    <p class="text-lg text-gris">Suspendes el examen práctico si cometes:</p>
    <ul class="mt-4 space-y-2 text-lg font-semibold">
      <li>· 1 falta eliminatoria</li>
      <li>· 2 faltas deficientes</li>
      <li>· 1 deficiente y 5 leves</li>
      <li>· 10 faltas leves</li>
    </ul>

    <div class="mt-8 hidden rounded-3xl bg-papel-2 p-5 sm:p-6 [.con-js_&]:block">
      <p class="font-bold">Pruébalo: ¿qué has hecho en el examen?</p>
      <div class="mt-4 grid grid-cols-3 gap-2">
        {
          TIPOS.map((t) => (
            <button type="button" data-suma={t.id} class={`boton !min-h-16 flex-col !gap-0 !rounded-2xl !px-2 text-sm leading-tight ${t.color}`}>
              <span class="text-2xl font-black" data-cuenta={t.id}>0</span>
              + {t.nombre}
            </button>
          ))
        }
      </div>
      <div class="mt-5 flex items-center justify-between gap-4 rounded-2xl border-2 border-filete p-4" aria-live="polite">
        <p>
          <span class="block text-2xl font-black" data-veredicto>APTO</span>
          <span class="text-gris" data-motivo>Sin faltas. ¡Enhorabuena!</span>
        </p>
        <button type="button" data-borra class="shrink-0 rounded-full px-4 py-2 font-semibold text-azul hover:bg-filete">Empezar</button>
      </div>
    </div>
  </div>

  <div class="grid gap-3">
    {
      TIPOS.map((t) => (
        <details class="group rounded-2xl border border-filete bg-papel-2 p-5 open:pb-6">
          <summary class="flex cursor-pointer list-none items-center gap-3 font-bold">
            <span class={`rounded-full px-2.5 py-0.5 text-sm ${t.color}`}>{t.nombre}</span>
            Ejemplos
            <span class="ml-auto text-xl text-azul transition group-open:rotate-45">+</span>
          </summary>
          <ul class="mt-4 space-y-1.5 text-gris">
            {t.lista.map((f) => <li>{f}</li>)}
          </ul>
        </details>
      ))
    }
  </div>
</div>

<script>
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-faltas]')) {
    raiz.classList.add('con-js')
    const n = { e: 0, d: 0, l: 0 }
    const $ = (s: string) => raiz.querySelector<HTMLElement>(s)!

    function pintar() {
      for (const k of ['e', 'd', 'l'] as const) $(`[data-cuenta="${k}"]`).textContent = String(n[k])
      let motivo = ''
      if (n.e >= 1) motivo = 'Una eliminatoria basta para suspender.'
      else if (n.d >= 2) motivo = 'Dos deficientes son un no apto.'
      else if (n.d === 1 && n.l >= 5) motivo = 'Una deficiente y cinco leves: no apto.'
      else if (n.l >= 10) motivo = 'Diez leves: no apto.'
      $('[data-veredicto]').textContent = motivo ? 'NO APTO' : 'APTO'
      $('[data-veredicto]').classList.toggle('text-red-600', !!motivo)
      $('[data-motivo]').textContent =
        motivo || (n.d + n.l === 0 ? 'Sin faltas. ¡Enhorabuena!' : 'Vas bien, pero ojo con sumar más.')
    }
    raiz.querySelectorAll<HTMLButtonElement>('[data-suma]').forEach((b) =>
      b.addEventListener('click', () => {
        n[b.dataset.suma as 'e' | 'd' | 'l']++
        pintar()
      }),
    )
    $('[data-borra]').addEventListener('click', () => {
      n.e = n.d = n.l = 0
      pintar()
    })
  }
</script>
