---
import Icono from './Icono.astro'
import { CENTRO, MAPA, tel } from '../lib/empresa.js'
---

<section class="relative overflow-hidden bg-senal py-20 text-white sm:py-28">
  <div class="franja franja-clara absolute inset-x-0 top-0 opacity-30"></div>
  <div class="contenedor grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:items-end">
    <div data-aparece>
      <h2 class="text-5xl font-black sm:text-7xl">Tu carnet empieza con una llamada.</h2>
      <p class="mt-6 max-w-lg text-lg text-white/85">
        Te contamos precios, horarios y cuándo empieza el próximo curso. Sin compromiso.
      </p>
    </div>
    <div class="grid gap-3" data-aparece style="--retraso:100ms">
      <a href={tel()} class="flex items-center justify-between gap-4 rounded-2xl bg-white/10 px-5 py-5 transition hover:bg-white/18">
        <span class="font-semibold">Llámanos</span>
        <span class="inline-flex items-center gap-2 text-2xl font-black whitespace-nowrap sm:text-3xl">
          <Icono nombre="phone" class="size-6 text-amarillo" />
          {CENTRO.telefono}
        </span>
      </a>
      <a href={MAPA} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-2xl bg-white/10 px-5 py-4 transition hover:bg-white/18">
        <Icono nombre="map-pin" class="size-5 shrink-0 text-amarillo" />
        <span><span class="font-semibold">{CENTRO.direccion}</span><span class="block text-white/75">{CENTRO.cp} {CENTRO.ciudad}</span></span>
        <Icono nombre="arrow-up-right" class="ml-auto size-4 opacity-70" />
      </a>
      <a href="/contacto/" class="boton boton-amarillo mt-2">Prefiero que me llaméis <Icono nombre="arrow-right" class="size-4.5" /></a>
    </div>
  </div>
</section>
