---
// Carteles de cursos y avisos que sube la autoescuela desde /admin. Sin novedades, la sección no sale.
// Cada tarjeta entera lleva a su página (/novedades/<id>/), con el cartel grande y todo el texto.
import Icono from './Icono.astro'
import { ETIQUETAS, fechaLarga, urlMiniatura } from '../lib/contenido.js'

interface Props {
  lista: any[]
}
const { lista } = Astro.props
---

{
  lista.length > 0 && (
    <section id="novedades" class="bg-asfalto pt-14 text-white sm:pt-20" aria-labelledby="novedades-titulo">
      <div class="contenedor">
        <p class="rotulo !text-celeste mb-3">Novedades</p>
        <h2 id="novedades-titulo" class="text-4xl font-black sm:text-5xl">
          Próximos cursos y avisos
        </h2>
      </div>
      {/* Se deslizan de lado; en escritorio caben varias a la vez */}
      <div class="contenedor mt-8">
        <ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-4 [scrollbar-width:thin] sm:-mx-8 sm:scroll-px-8 sm:px-8">
          {lista.map((n) => (
            <li class="flex w-[78%] max-w-80 shrink-0 snap-start sm:w-72">
              <a href={`/novedades/${n.id}/`} class="tarjeta group flex w-full flex-col overflow-hidden rounded-3xl bg-white/6 transition hover:bg-white/10">
                <span class="block overflow-hidden">
                  {n.imagen ? (
                    <img
                      src={urlMiniatura(n.imagen)}
                      width={n.ancho}
                      height={n.alto}
                      alt=""
                      loading="lazy"
                      class="aspect-[3/4] w-full object-cover object-top transition duration-500 group-hover:scale-[1.03]"
                    />
                  ) : (
                    // Sin cartel: la fecha en grande sobre el azul de marca, para que no quede un hueco
                    <span class="grid aspect-[3/4] place-items-center bg-senal text-center" aria-hidden="true">
                      {n.fecha ? (
                        <span class="leading-none font-black">
                          <span class="block text-8xl">{new Date(`${n.fecha}T12:00:00`).getDate()}</span>
                          <span class="mt-2 block text-2xl tracking-wide uppercase">
                            {new Date(`${n.fecha}T12:00:00`).toLocaleDateString('es-ES', { month: 'long' })}
                          </span>
                        </span>
                      ) : (
                        <Icono nombre="route" class="size-20 opacity-80" />
                      )}
                    </span>
                  )}
                </span>
                <span class="flex flex-1 flex-col p-5">
                  <span class="flex flex-wrap items-center gap-2 text-sm font-bold">
                    <span class="rounded-full bg-senal px-2.5 py-0.5">{ETIQUETAS[n.etiqueta]}</span>
                    {n.fecha && <span class="text-celeste">Empieza el {fechaLarga(n.fecha)}</span>}
                  </span>
                  <span class="mt-3 block text-xl leading-tight font-extrabold">{n.titulo}</span>
                  {n.texto && <span class="mt-2 line-clamp-3 block text-white/75">{n.texto}</span>}
                  <span class="mt-auto inline-flex items-center gap-2 pt-5 font-bold text-celeste">
                    Ver todo <Icono nombre="arrow-right" class="size-4 transition group-hover:translate-x-1" />
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
