---
import Logo from './Logo.astro'
import Icono from './Icono.astro'
import { CENTROS, EMPRESA, ENLACES, tel, mapa } from '../lib/empresa.js'
import { GRUPOS } from '../lib/permisos.js'
import { CURSOS } from '../lib/cursos.js'
---

<footer class="bg-asfalto text-white/75">
  <div class="franja franja-clara opacity-15"></div>
  <div class="contenedor grid gap-12 py-16 md:grid-cols-[1.3fr_1fr_1fr]">
    <div>
      <Logo claro class="text-lg" />
      <p class="mt-5 max-w-sm">
        Autoescuela y centro de formación en La Serena y las Vegas Altas desde {EMPRESA.desde}. Todos los permisos, del
        ciclomotor al tráiler, y formación profesional.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`mailto:${EMPRESA.email}`} class="inline-flex items-center gap-2 font-semibold text-white hover:underline">
          <Icono nombre="mail" class="size-4" />{EMPRESA.email}
        </a>
      </div>
      <a href={EMPRESA.facebook} target="_blank" rel="noopener" class="mt-3 inline-flex items-center gap-2 font-semibold text-white hover:underline">
        Síguenos en Facebook <Icono nombre="arrow-up-right" class="size-4" />
      </a>
    </div>

    <div class="grid grid-cols-2 gap-8 md:contents">
      <div>
        <p class="mb-4 text-sm font-extrabold tracking-[0.14em] text-white uppercase">Permisos</p>
        <ul class="space-y-2">
          {GRUPOS.map((g) => <li><a class="hover:text-white" href={`/permisos/#${g.id}`}>{g.titulo}</a></li>)}
        </ul>
      </div>
      <div>
        <p class="mb-4 text-sm font-extrabold tracking-[0.14em] text-white uppercase">Cursos</p>
        <ul class="space-y-2">
          {CURSOS.map((c) => <li><a class="hover:text-white" href={`/cursos/${c.slug}/`}>{c.nombre}</a></li>)}
          <li><a class="hover:text-white" href="/cursos/#gratis">Formación gratuita</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="contenedor grid gap-6 border-t border-white/10 py-10 sm:grid-cols-3">
    {
      CENTROS.map((c) => (
        <div>
          <p class="font-bold text-white">{c.ciudad}</p>
          <a href={mapa(c)} target="_blank" rel="noopener" class="block hover:text-white">
            {c.direccion}, {c.cp}
          </a>
          <a href={tel(c.telefono)} class="font-semibold text-amarillo">
            {c.telefono}
          </a>
        </div>
      ))
    }
  </div>

  <div class="contenedor flex flex-col gap-3 border-t border-white/10 py-6 text-sm sm:flex-row sm:items-center">
    <p>© {new Date().getFullYear()} {EMPRESA.nombre}</p>
    <nav class="flex flex-wrap gap-x-5 gap-y-1 sm:ml-auto" aria-label="Legal">
      <a class="hover:text-white" href="/privacidad/">Privacidad</a>
      <a class="hover:text-white" href={ENLACES.notas} target="_blank" rel="noopener">Notas DGT</a>
      <span class="text-white/45">Web por extreweb</span>
    </nav>
  </div>
</footer>
