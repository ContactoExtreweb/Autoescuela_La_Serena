---
// Vehículos de prácticas que la autoescuela sube desde /admin. Sin vehículos, no sale nada.
import { PERMISOS } from '../lib/permisos.js'
import { urlImagen, urlMiniatura } from '../lib/contenido.js'

interface Props {
  lista: any[]
  /** Enseñar con qué permisos se usa cada uno (en /autoescuela/; en la ficha de un permiso sobra) */
  conPermisos?: boolean
}
const { lista, conPermisos = false } = Astro.props
const clase = (slug) => PERMISOS.find((p) => p.slug === slug)
---

{
  lista.length > 0 && (
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {lista.map((v) => (
        <li class="overflow-hidden rounded-3xl border border-filete bg-papel-2" data-aparece>
          <a href={urlImagen(v.imagen)} data-visor={v.nombre} class="block">
            <img src={urlMiniatura(v.imagen)} width={v.ancho} height={v.alto} alt={v.nombre} loading="lazy" class="aspect-[4/3] w-full object-cover" />
          </a>
          <div class="p-5">
            <h3 class="text-xl font-extrabold">{v.nombre}</h3>
            {v.descripcion && <p class="mt-1 text-gris">{v.descripcion}</p>}
            {conPermisos && v.permisos.length > 0 && (
              <p class="mt-3 flex flex-wrap gap-1.5">
                {v.permisos.map(clase).filter(Boolean).map((p) => (
                  <a href={`/permisos/${p.slug}/`} class="rounded-md bg-senal px-2 py-0.5 text-sm font-black text-white">
                    {p.clase}
                  </a>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}
