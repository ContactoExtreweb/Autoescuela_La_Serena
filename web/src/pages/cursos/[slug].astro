---
import Base from '../../layouts/Base.astro'
import Cabeza from '../../components/Cabeza.astro'
import Icono from '../../components/Icono.astro'
import Aside from '../../components/Aside.astro'
import { CURSOS } from '../../lib/cursos.js'
import { permiso } from '../../lib/permisos.js'

export function getStaticPaths() {
  return CURSOS.map((c) => ({ params: { slug: c.slug }, props: { c } }))
}
const { c } = Astro.props
const otros = CURSOS.filter((x) => x.slug !== c.slug).slice(0, 4)
---

<Base titulo={`Curso de ${c.nombre}`} descripcion={`${c.largo}: ${c.resumen} En Villanueva de la Serena, Don Benito y Navalvillar de Pela.`}>
  <Cabeza
    rotulo={c.largo}
    titulo={c.nombre}
    texto={c.resumen}
    migas={[
      { href: '/cursos/', texto: 'Cursos' },
      { href: `/cursos/${c.slug}/`, texto: c.nombre },
    ]}
  />

  <div class="contenedor grid gap-12 py-14 sm:py-20 lg:grid-cols-[1fr_22rem] lg:gap-16">
    <div class="space-y-12">
      <section class="space-y-5 text-xl leading-relaxed">
        {c.texto.map((t) => <p>{t}</p>)}
      </section>

      {
        c.datos && (
          <dl class="grid gap-3 sm:grid-cols-3">
            {c.datos.map(([k, v]) => (
              <div class="rounded-2xl bg-papel-2 p-5">
                <dt class="text-sm text-gris">{k}</dt>
                <dd class="mt-1 text-2xl font-black">{v}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {
        c.permisos && (
          <section>
            <h2 class="text-3xl font-black">Va con estos permisos</h2>
            <div class="mt-5 flex flex-wrap gap-2">
              {c.permisos.map(permiso).map((p) => (
                <a href={`/permisos/${p.slug}/`} class="senal grid h-16 min-w-16 place-items-center px-4 text-xl font-black">
                  {p.clase}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <a href="/cursos/#gratis" class="group flex items-center gap-5 rounded-3xl bg-amarillo p-6 text-asfalto sm:p-8">
        <span class="text-4xl font-black whitespace-nowrap">0 €</span>
        <span>
          <span class="block text-xl font-extrabold">¿Estás en paro?</span>
          <span class="block">Pregunta si este curso entra en la formación gratuita del SEXPE.</span>
        </span>
        <Icono nombre="arrow-right" class="ml-auto size-6 shrink-0 transition group-hover:translate-x-1" />
      </a>

      <section>
        <h2 class="text-2xl font-black">Otros cursos</h2>
        <ul class="mt-4 divide-y divide-filete border-y border-filete">
          {
            otros.map((o) => (
              <li>
                <a href={`/cursos/${o.slug}/`} class="group flex items-center gap-4 py-4">
                  <Icono nombre={o.icono} class="size-6 text-azul" />
                  <span class="font-bold">{o.nombre}</span>
                  <Icono nombre="arrow-right" class="ml-auto size-5 text-azul transition group-hover:translate-x-1" />
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <Aside interes={`Curso de ${c.nombre}`} />
  </div>
</Base>
