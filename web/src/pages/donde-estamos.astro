---
import Base from '../layouts/Base.astro'
import Cabeza from '../components/Cabeza.astro'
import Icono from '../components/Icono.astro'
import Ubicacion from '../components/Ubicacion.astro'
import { CENTRO, EMPRESA } from '../lib/empresa.js'
---

<Base
  titulo="Dónde estamos: autoescuela en Villanueva de la Serena"
  descripcion={`La Serena Autoescuelas: ${CENTRO.direccion}, ${CENTRO.cp} ${CENTRO.ciudad} (Badajoz). Teléfono ${CENTRO.telefono}.`}
>
  <Cabeza
    rotulo="Dónde estamos"
    titulo="En el centro de Villanueva de la Serena."
    texto="Pásate cuando quieras o llámanos: te contamos todo sin compromiso."
    migas={[{ href: '/donde-estamos/', texto: 'Dónde estamos' }]}
  />

  <section class="py-14 sm:py-20">
    <div class="contenedor"><Ubicacion /></div>
  </section>

  <section class="bg-asfalto py-14 text-white">
    <div class="contenedor flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-2xl font-black">¿Prefieres escribirnos?</p>
      <div class="flex flex-wrap gap-3">
        <a href={`mailto:${EMPRESA.email}`} class="boton boton-borde text-white"><Icono nombre="mail" class="size-4.5" />{EMPRESA.email}</a>
        <a href="/contacto/" class="boton boton-amarillo">Formulario</a>
      </div>
    </div>
  </section>
</Base>
